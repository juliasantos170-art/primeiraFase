        inteiro valorPJ = 9000
       inteiro  totalValor

        inteiro mediaValorPF
        inteiro mediaValorPJ
        inteiro mediaTempoPF
        inteiro mediaTempoPJ

        //processamento 
        totalRelatorios = relatoriosPF + relatoriosPJ
        totalTempo = tempoPF + tempoPJ
