programa
{
    funcao inicio()
    {
      //variaveis 
        real corrida1, corrida2, corrida3, corrida4, corrida5
        real total
        
        //entrada de dados 
        escreva("Digite o valor da primeira corrida: R$ ")
        leia(corrida1)

        escreva("Digite o valor da segunda corrida: R$ ")
        leia(corrida2)

        escreva("Digite o valor da terceira corrida: R$ ")
        leia(corrida3)

        escreva("Digite o valor da quarta corrida: R$ ")
        leia(corrida4)

        escreva("Digite o valor da quinta corrida: R$ ")
        leia(corrida5)
        
        //processamento 
        total = corrida1 + corrida2 + corrida3 + corrida4 + corrida5
         
         //saida 
        escreva("\nTotal faturado no dia: R$ ", total)
    }
}
