programa {
  funcao inicio() {
    //variaveis
    inteiro n 
    real chance 

    //entrada de dados 
    escreva("digite o numero de vezes que usou o celular:" )
    leia(n)

    //processamento 
    chance = (0.1 / (1 + 500 *n)) *100 

    //saida 
    escreva (" chance de aprovacao: "+ chance + "% ")
  
  }
}
