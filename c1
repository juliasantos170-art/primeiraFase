programa {
  funcao inicio() {
    inteiro caminhoes, jares
    inteiro faturamento, custo, lucro

        escreva("Digite a quantidade de caminhoes: ")
        leia(caminhoes)

        jares = caminhoes * 50
        faturamento = jares * 90
        custo = caminhoes * 450
        lucro = faturamento - custo

        escreva("\nJares vendidos: ", jares)
        escreva("\nFaturamento: R$ ", faturamento)
        escreva("\nCustos: R$ ", custo)
        escreva("\nLucro da temporada: R$ ", lucro)
    }
}

