programa {
  funcao inicio() {
  //variaveis 
  real preco, valeTroca 
  inteiro quantidade 

  //entrada de dados 
  escreva("digite o preco de cada par: ")
  leia(preco)
  escreva("digite a quantidade de pares trocados: ")
  leia(quantidade)

  //processamento
  valeTroca = preco*quantidade 

  //saida
  escreva("valor do vale-troca :R$", valeTroca)
  }
}
