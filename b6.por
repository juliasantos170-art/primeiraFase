programa {
  funcao inicio() {
  //entendimento 
  //calcular quanto ele investiu
  //calcular quanto ele lucrou 
  //variaveis
  real custo, precoVenda 
  //entrada de dados 
  escreva("digite o custo da obra: ")
  leia(custo)
  escreva("digite o precoVenda: ")
  leia(precoVenda)
  //processamento
  precoVenda = custo *3
  //saida 
  escreva("preco de venda:R$ ")
  escreva(precoVenda)
  }
}
