programa {
  funcao inicio() {
 //entendimento do problema
 //quantidades de laranjas 

 //infos e variaveis
 inteiro laranjas , quantidade, total

 //entrada de dados 
 escreva("digite a quantidade de laranjas: ")
 leia(laranjas)
 escreva("digite quantidade de laranjas: ")
 leia(quantidade)

 //processamento 
 total = laranjas - quantidade
 //saida 
escreva("quantidade de laranja")
escreva(total)
  }
}