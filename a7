programa {
  funcao inicio() {
    //variaveis 
    real pesoTotal, tara, pesoCarga 

    //entrada de dados 
    escreva("digite o peso total do caminhao: ")
    leia(pesoTotal)
    
    escreva("digite a tara do caminhao: ")
    leia(tara)

    //processamento 
    pesoCarga = pesoTotal - tara 

    //saida 
    escreva("peso da carga: ", pesoCarga )

  }
}
